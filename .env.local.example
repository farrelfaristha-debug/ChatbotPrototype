# Copy to .env.local and fill in values.

# Anthropic Claude (disarankan untuk jawaban lebih konsisten) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Opsional — default di kode: claude-sonnet-4-20250514 (snapshot lama seperti claude-3-5-sonnet-20241022 sering 404)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Alternatif murah: claude-3-haiku-20240307

# OpenAI — dipakai hanya jika ANTHROPIC_API_KEY kosong
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# WhatsApp Cloud API (optional) — see Meta Developer: WhatsApp > API Setup
# Public webhook URL must be HTTPS (use ngrok in development).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional override (default v21.0)
# WHATSAPP_GRAPH_API_VERSION=v21.0
